PG_HOST=your-postgres-host
PG_NAME=main
PG_USER=your-postgres-user
PG_PASSWORD=your-postgres-password
PG_PORT=5432
PG_SSLMODE=require
PG_CONNECT_TIMEOUT=10

PG_HOST_CHILE=your-postgres-host
PG_NAME_CHILE=main
PG_USER_CHILE=your-postgres-user
PG_PASSWORD_CHILE=your-postgres-password
PG_PORT_CHILE=5432
PG_SSLMODE_CHILE=require
PG_CONNECT_TIMEOUT_CHILE=10

SAP_HANA_HOST=172.31.28.162
SAP_HANA_PORT=30015
SAP_HANA_USER=your-user
SAP_HANA_PASSWORD=your-password
SAP_HANA_ENCRYPT=
SAP_HANA_SSL_VALIDATE_CERTIFICATE=
SAP_HANA_SSL_TRUST_STORE=
SAP_HANA_SSL_KEY_STORE_PASSWORD=
SAP_HANA_CONNECT_TIMEOUT=

MYSQL_HOST=
MYSQL_NAME=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT=10

FECHA_INICIO=2025-09-01T00:00:00
FECHA_FIN=2025-12-01T00:00:00
# Base local (SQLite) con datos propios de la app: marcas de tickets y lo que
# se agregue despues. Si se omite, usa data/local.db en la raiz del proyecto.
LOCAL_DB_PATH=

SAP_OUTPUT_PATH=OUTPUT/SAP.xlsx
PG_OUTPUT_PATH=OUTPUT/TUTATI.xlsx
COMPARACION_OUTPUT_PATH=OUTPUT/COMPARACION.xlsx
REINTENTOS_CONEXION=5
ESPERA_REINTENTO_SEGUNDOS=10
UI_WIDTH=360
UI_HEIGHT=260


SL_USER=tu_usuario
SL_PASSWORD=tu_contraseña

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@dominio.com
SMTP_PASSWORD=tu_app_password_de_gmail
SMTP_FROM=tu_correo@dominio.com
# Si tiene valor, TODOS los correos van solo a esa dirección (modo prueba).
# Vaciar esta variable para enviar a los destinatarios reales (producción).
SMTP_OVERRIDE_TO=esencia@platanitos.com
# Mattermost: el alta de usuarios corre un script en el Linux, por SSH.
# Sin MATTERMOST_SSH_HOST el modulo queda apagado y el resto de la app sigue igual.
MATTERMOST_SSH_HOST=100.100.100.234
MATTERMOST_SSH_PORT=22
MATTERMOST_SSH_USER=tu_usuario_linux
MATTERMOST_SSH_PASSWORD=tu_contraseña_linux
# Solo si la de sudo es distinta a la de arriba. Vacia = usa la misma.
MATTERMOST_SUDO_PASSWORD=
MATTERMOST_DIR=mattermost
MATTERMOST_SCRIPT=./crear_usuario_individual.sh
# Segundos de espera antes de cortar el script.
MATTERMOST_TIMEOUT=180
